# Copy to .env. It is git-ignored; never commit real keys.

# Required for AI chat. Without it, chat reports that the assistant is unavailable.
OPENROUTER_API_KEY=your-openrouter-api-key-here

# Optional: real market data. Leave empty to use the built-in simulator.
# The free Basic plan only gets end-of-day closes, so prices won't tick.
MASSIVE_API_KEY=

# Optional: "true" with a Massive key starts the simulator from real closes, so
# prices are realistic and still tick on the free plan. Tickers Massive does not
# know stay unpriced. Paid plans can leave this off to get live data.
MASSIVE_SEED_SIMULATOR=false

# Optional: seconds between Massive polls. Default 15.
MASSIVE_POLL_INTERVAL=

# Optional: "true" gives deterministic replies with no LLM calls.
LLM_MOCK=false
